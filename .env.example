# === Qloo Hackathon API ===
# Required. Obtained from Qloo (hackathon key, sent by email).
QLOO_API_KEY=

# === DeepSeek ===
# Required for intent parsing. https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Optional — DeepSeek base URL (defaults to https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# The single city Elsewhere operates in (first version fixed to Tokyo).
# ELSEWHERE_CITY=Tokyo
